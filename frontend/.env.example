# Application Configuration
VITE_APP_NAME="re:Invent Planner"
VITE_APP_DESCRIPTION="AI-powered conference planning assistant"
VITE_PRIMARY_COLOR="#FF9900"

# AWS Cognito Configuration
# Get these values from AWS Console > Cognito > User Pools
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
VITE_AWS_REGION=us-east-1
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# API Configuration
# Get this from AWS Console > API Gateway
VITE_API_ENDPOINT=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/prod/mss-template/agent
